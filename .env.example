# Groq Cloud (fast, free tier) - get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local fallback via Ollama (https://ollama.com) - run: ollama pull llama3.2:3b
LOCAL_MODEL=llama3.2:3b

# Optional: broader web research for topic quizzes - https://tavily.com (free tier)
TAVILY_API_KEY=

# Optional: change the port (default 8000)
PORT=8000
